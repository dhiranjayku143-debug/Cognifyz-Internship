<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Submission Result</title>
</head>
<body style="font-family: Arial, sans-serif; max-width: 520px; margin: 30px auto; padding: 0 15px;">
  <h1 style="color: #27ae60;">Thank you, <%= entry.name %>!</h1>
  <p>Data save ho gaya:</p>
  <ul>
    <li><strong>Email:</strong> <%= entry.email %></li>
    <li><strong>Phone:</strong> <%= entry.phone %></li>
    <li><strong>Age:</strong> <%= entry.age %></li>
    <li><strong>Gender:</strong> <%= entry.gender %></li>
    <li><strong>Country:</strong> <%= entry.country %></li>
    <li><strong>Hobbies:</strong> <%= entry.hobbies.length ? entry.hobbies.join(', ') : '-' %></li>
    <li><strong>Message:</strong> <%= entry.message %></li>
  </ul>
  <a href="/forms">Go back</a> | <a href="/forms/submissions">View all submissions</a>
</body>
</html>
